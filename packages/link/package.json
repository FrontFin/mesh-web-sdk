{
  "name": "@meshconnect/web-link-sdk",
  "version": "3.12.0",
  "description": "A client-side JS library for integrating with Mesh Connect",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/FrontFin/mesh-web-sdk.git",
  "homepage": "https://github.com/FrontFin/mesh-web-sdk",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-typescript": "^7.20.0",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.5.0",
    "eslint": "^7.23.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.2.1",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.4",
    "util": "^0.12.4"
  },
  "dependencies": {
    "@meshconnect/node-api": "^2.0.27",
    "@meshconnect/uwc-bridge-parent": "1.6.0"
  },
  "scripts": {
    "build": "pnpm run updateVersion && rimraf dist && pnpm run build:esm && pnpm run copy",
    "build:esm": "tsc --outDir dist",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint **/*.ts",
    "copy": "node ./tools/copy",
    "updateVersion": "node ./tools/update-version",
    "publish:npm": "pnpm run build && cd dist && npm publish --access public --provenance --registry https://registry.npmjs.org",
    "test": "jest",
    "test:cov": "jest --ci --coverage"
  }
}
