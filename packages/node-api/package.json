{
  "name": "@meshconnect/node-api",
  "version": "2.0.28",
  "description": "A node.js client library for the Mesh API",
  "type": "module",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "repository": "https://github.com/FrontFin/mesh-web-sdk.git",
  "homepage": "https://github.com/FrontFin/mesh-web-sdk",
  "devDependencies": {
    "eslint": "^7.23.0",
    "rimraf": "^5.0.10",
    "typescript": "^4.6.4",
    "swagger-typescript-api": "^13.12.6"
  },
  "scripts": {
    "build": "rimraf dist && pnpm run build:esm && pnpm run build:cjs && pnpm run copy",
    "build:esm": "tsc --outDir dist",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,js",
    "copy": "node ./tools/copy",
    "updateApi": "node ./tools/updateSwagger && swagger-typescript-api generate -p ./swagger.json -r --enum-style=union --add-readonly --axios --api-class-name FrontApi -n api.ts --module-name-first-tag",
    "publish:npm": "pnpm run build && cd dist && npm publish --access public --provenance --registry https://registry.npmjs.org"
  },
  "dependencies": {
    "axios": "1.18.0"
  }
}
