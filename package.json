{
  "name": "@meshconnect/mesh-b2b-sdk",
  "version": "2.0.3",
  "description": "Mesh Connect JS SDKs",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^7.23.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.4.0",
    "lerna": "^9.0.7",
    "prettier": "^2.2.1",
    "rimraf": "^5.0.10",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "typecheck": "lerna run typecheck",
    "lint": "lerna run lint",
    "build": "lerna run build",
    "test": "lerna run test",
    "test:updateSnapshots": "lerna run test -- -u",
    "test:cov": "lerna run test:cov",
    "lint:fix": "lerna run lint -- --fix",
    "start:demo": "cd examples/react-example && pnpm run start",
    "updateApi": "cd packages/node-api && pnpm run updateApi",
    "publish:npm": "lerna run publish:npm",
    "postinstall": "cd packages/link && pnpm run updateVersion"
