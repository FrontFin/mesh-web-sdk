# SR-16 (Dependency Security): 24h cooldown before a freshly published version
# can be resolved, so a compromised release has time to be flagged and unpublished.
#
# NOTE THE UNITS. npm's `min-release-age` is in DAYS (npm 12+; `hint: <days>`),
# whereas pnpm's `minimumReleaseAge` is in MINUTES. 24h is therefore `1` here and
# `1440` in pnpm-workspace.yaml. Do not copy 1440 into this file - under npm that
# would demand packages ~4 years old and fail every install.
#
# Installs in this repo go through pnpm, which ignores this key entirely; the
# enforced control lives in pnpm-workspace.yaml. This file covers direct `npm`
# invocations. npm 11.x does not know the key and warns that it is unknown, which
# is harmless.
min-release-age=1
